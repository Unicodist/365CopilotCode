{
  "name": "365-copilot-code",
  "displayName": "365 Copilot Code",
  "description": "Coding assistance in VS Code powered by Microsoft 365 Copilot.",
  "version": "0.0.1",
  "publisher": "unicodist",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Unicodist/365CopilotCode.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Programming Languages"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "365CopilotCode.helloWorld",
        "title": "Hello World",
        "category": "365 Copilot Code"
      },
      {
        "command": "365CopilotCode.signIn",
        "title": "Sign In to Microsoft 365 Copilot",
        "category": "365 Copilot Code",
        "icon": "$(sign-in)"
      },
      {
        "command": "365CopilotCode.signOut",
        "title": "Sign Out of Microsoft 365 Copilot",
        "category": "365 Copilot Code",
        "icon": "$(sign-out)"
      }
    ],
    "configuration": {
      "title": "365 Copilot Code",
      "properties": {
        "365CopilotCode.auth.clientId": {
          "type": "string",
          "default": "",
          "markdownDescription": "Application (client) ID of your own Microsoft Entra app registration. Leave empty to use VS Code's built-in Microsoft sign-in. Your tenant may require its own app registration with admin consent for the Microsoft 365 Copilot Chat API permissions.",
          "scope": "application"
        },
        "365CopilotCode.auth.tenantId": {
          "type": "string",
          "default": "",
          "markdownDescription": "Microsoft Entra tenant ID or domain (for example `contoso.onmicrosoft.com`) to sign in to. Leave empty to sign in with any work or school account.",
          "scope": "application"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "package": "vsce package"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.95.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
